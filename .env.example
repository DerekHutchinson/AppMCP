APP_SECRET=your-hmac-secret-min-32-chars
APP_BASE_URL=https://appmcp.example.com

# --- app registry (on the mounted data volume so it survives redeploys) ---
REGISTRY_DB=/app/data/apps.sqlite
# Rows per page for AppData.query pagination; MAX_QUERY_ROWS is the overall
# auto-pagination ceiling (browser-protection), not a per-page limit.
QUERY_PAGE_SIZE=1000
MAX_QUERY_ROWS=50000
QUERY_TIMEOUT=20

# --- data sources (same shape/values as KPIMCP, but point at READ-ONLY accounts) ---
# allowed_schemas is the real boundary for what any published app can read.
# BigQuery is auth'd by a service account instead of a DSN. Its "schemas" are
# datasets (tables are dataset-qualified: dataset.table). Add an entry shaped
# like (base64-encode the whole service-account JSON key for credentials_b64):
#   "bq":{"kind":"bigquery","project":"my-gcp-project","location":"US",
#     "credentials_b64":"<base64 of the SA key json>",
#     "allowed_schemas":"analytics,marts","description":"BigQuery warehouse"}
# Per-source cost cap: add "max_bytes_billed": <bytes> to override the default.
DATASOURCES_JSON={"redshift":{"kind":"redshift","dsn":"postgresql://ro_user:pass@host:5439/dbname","allowed_schemas":"sales,inventory,customers","description":"Warehouse"},"b2b_mysql":{"kind":"mysql","dsn":"mysql://ro_user:pass@host:3306/app_live","allowed_schemas":"app_live","description":"B2B site DB"}}
DEFAULT_DATASOURCE=redshift
# Default per-query cost ceiling for BigQuery sources (bytes; 1 GiB). 0 disables.
BIGQUERY_MAX_BYTES_BILLED=1073741824

# --- MCP endpoint auth + viewer login (Azure AD) ---
# When true: /mcp requires an Azure AD bearer token, and the web UI (catalog,
# app viewer, manage) requires an Azure AD browser session. When false: /mcp is
# open and the web UI is only mounted in LOCAL_MODE (see .env.local.example).
AUTH_ENABLED=false
PUBLIC_BASE_URL=https://appmcp.example.com
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret
# Register {public_base}/auth/callback as a redirect URI on the Azure app.
AZURE_POST_LOGOUT_REDIRECT_URL=
ALLOWED_EMAIL_DOMAIN=@example.com
ALLOWED_EMAILS=
TOOL_ACCESS_PATH=tool_access.json

# --- web session ---
SESSION_TTL_SECONDS=28800

# --- email (SendGrid) for the app /a/{slug}/email endpoint ---
# Apps call AppData.sendEmail({to, subject, html}); the server sends via
# SendGrid. Recipients are restricted to ALLOWED_EMAIL_DOMAIN (internal only).
# Leave SENDGRID_API_KEY/EMAIL_FROM empty to disable the endpoint (returns 503).
# EMAIL_FROM must be a verified SendGrid sender/domain.
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=apps@example.com
EMAIL_FROM_NAME=Example Apps
EMAIL_MAX_RECIPIENTS=25
EMAIL_RATE_PER_MIN=30

# --- Microsoft Graph proxy for the app /a/{slug}/graph endpoint ---
# Apps call AppData.graph(path, opts); the server forwards to Microsoft Graph
# using the SIGNED-IN USER's delegated token (captured at login, refreshed as
# needed, stored encrypted server-side). Calls are pinned to /me + a method+path
# allowlist. GRAPH_SCOPES must be granted (admin consent) on the Azure app
# registration; offline_access is added automatically for refresh tokens.
# Set GRAPH_ENABLED=false to disable the endpoint (returns 503).
GRAPH_ENABLED=false
GRAPH_SCOPES=User.Read Mail.Read Mail.Send Calendars.ReadWrite Files.Read Chat.Read
GRAPH_RATE_PER_MIN=60
GRAPH_MAX_RESPONSE_BYTES=2000000

# --- U.S. Census Bureau Data API proxy for the app /a/{slug}/census endpoint ---
# Apps call AppData.census({dataset, year, get, for, in, ...}); the server
# forwards to https://api.census.gov/data with the API key held ONLY here (never
# in the app). Public, read-only statistics (population, demographics, income,
# housing, economy). Get a free key at https://api.census.gov/data/key_signup.html.
# Set CENSUS_ENABLED=false or leave CENSUS_API_KEY empty to disable (returns 503).
CENSUS_ENABLED=false
CENSUS_API_KEY=your-census-api-key
CENSUS_RATE_PER_MIN=60
CENSUS_MAX_RESPONSE_BYTES=5000000
CENSUS_TIMEOUT=30

# --- S3 object sources for the app /a/{slug}/s3 endpoint ---
# Apps call AppData.s3.list()/get(); the server fetches from Amazon S3 (or an
# S3-compatible endpoint) using credentials stored ONLY here (never in the app).
# Read-only: list + get objects. Each source is pinned to ONE bucket and an
# optional key prefix that confines everything the app can reach — point each at
# a LEAST-PRIVILEGE key (s3:GetObject + s3:ListBucket on just that bucket/prefix).
# Keep S3_SOURCES_JSON on ONE line. Leave empty to disable the endpoint (503).
# Each entry: {"bucket","region","access_key_id","secret_access_key",
#   "prefix"?,"endpoint_url"?,"description"?}.
S3_SOURCES_JSON={"reports":{"bucket":"my-bucket","region":"us-east-1","access_key_id":"AKIA...","secret_access_key":"...","prefix":"reports/","description":"Nightly report exports"}}
S3_MAX_OBJECT_BYTES=5242880
S3_MAX_LIST_KEYS=1000
S3_RATE_PER_MIN=120

# --- git history (audit trail of apps the agent builds) ---
# Every app create/update/publish/unpublish/delete writes
# <subdir>/<slug>/index.html + app.json into a git working tree, commits it, and
# pushes to GIT_HISTORY_BRANCH. deploy.sh auto-clones GIT_HISTORY_REPO_URL into
# ./data/app-history (mounted at /app/data/app-history) on first deploy using
# GIT_HISTORY_TOKEN. Git failures are logged and never block app operations.
GIT_HISTORY_ENABLED=true
GIT_HISTORY_REPO_PATH=/app/data/app-history
GIT_HISTORY_BRANCH=app-history
GIT_HISTORY_SUBDIR=apps
GIT_HISTORY_PUSH=true
GIT_HISTORY_REMOTE=origin
GIT_HISTORY_AUTHOR_NAME=AppMCP Bot
GIT_HISTORY_AUTHOR_EMAIL=appmcp-bot@example.com
# Used only by deploy.sh to clone the history repo (not read by the app).
# GIT_HISTORY_TOKEN must be a GitHub PAT with Contents: read & write on the repo.
GIT_HISTORY_REPO_URL=https://github.com/your-org/AppMCP-History.git
GIT_HISTORY_TOKEN=your-github-pat

# Extra script-src origins allowed inside published apps (space-separated).
CSP_SCRIPT_SRC_EXTRA=https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com
