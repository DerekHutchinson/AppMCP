# Copy to .env.local (gitignored) to run a local instance.
# .env.local overrides .env. The local dev bypass assumes a fixed admin identity
# so the catalog/manage UI works without any Azure sign-in.

LOCAL_MODE=true
LOCAL_BASE_URL=http://localhost:8000
AUTH_ENABLED=false
LOCAL_DEV_EMAIL=local-admin@localhost

# Point at a local/read-only DB for safe local testing (optional override).
# DATASOURCES_JSON={"redshift":{"kind":"postgres","dsn":"postgresql://postgres:postgres@localhost:5432/postgres","allowed_schemas":"public"}}
# DEFAULT_DATASOURCE=redshift
# REGISTRY_DB=apps.local.sqlite
